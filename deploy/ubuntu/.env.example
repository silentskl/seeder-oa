# Copy to deploy/ubuntu/.env, chmod 600, NEVER commit.
# Restore existing secrets. Do NOT rotate during cutover.
BETTER_AUTH_URL=https://oa.smartenx.com
OWNER_EMAIL=admin@example.com
BETTER_AUTH_SECRET=REPLACE_WITH_EXISTING_CLOUDFLARE_BETTER_AUTH_SECRET
VCS_ENCRYPTION_KEY=REPLACE_WITH_EXISTING_CLOUDFLARE_VCS_ENCRYPTION_KEY
OA_SETTINGS_MASTER_KEY=REPLACE_WITH_EXISTING_CLOUDFLARE_OA_SETTINGS_MASTER_KEY
OA_FINANCE_SYNC_TOKEN=REPLACE_WITH_EXISTING_CLOUDFLARE_OA_FINANCE_SYNC_TOKEN
OA_MULTI_ENTITY_BUSINESS_ENABLED=false
OA_FINANCE_MULTI_ENTITY_ENABLED=false
# Optional Worker secrets copied only when currently configured:
# OA_FINANCE_RESEND_API_KEY=
# OA_FINANCE_RESEND_WEBHOOK_SECRET=
# OA_FINANCE_AI_API_KEY=
# OA_FINANCE_AI_MODEL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# BETTER_AUTH_TRUSTED_ORIGINS=
# MCP_ALLOWED_ORIGINS=
OA_HTTP_PORT=3000
# Host path, e.g. /data/seeder-oa on Ubuntu; must be owned by uid 1000
OA_DATA_DIR=./data
