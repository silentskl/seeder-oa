# Copy to deploy/ubuntu/.env; chmod 600. Reuse EXISTING production keys.
# These are not secrets to rotate during a migration; obtain them from your
# Cloudflare deployment's secure secret store / backup, not from the database.
BETTER_AUTH_URL=https://oa.smartenx.com
BETTER_AUTH_SECRET=REPLACE_WITH_EXISTING_PRODUCTION_SECRET
VCS_ENCRYPTION_KEY=REPLACE_WITH_EXISTING_PRODUCTION_KEY
OA_SETTINGS_MASTER_KEY=REPLACE_WITH_EXISTING_PRODUCTION_KEY
OWNER_EMAIL=REPLACE_WITH_EXISTING_OWNER_EMAIL
# Set to the same values as the old Worker for a straight data migration.
OA_MULTI_ENTITY_BUSINESS_ENABLED=false
OA_FINANCE_MULTI_ENTITY_ENABLED=false
# Required for the isolated 5-minute mail sync container. 32+ characters.
OA_FINANCE_SYNC_TOKEN=REPLACE_WITH_EXISTING_32_PLUS_CHAR_SYNC_TOKEN
# Optional legacy env vars, if configured in the old Worker.
OA_FINANCE_RESEND_API_KEY=
OA_FINANCE_RESEND_WEBHOOK_SECRET=
OA_FINANCE_AI_API_KEY=
OA_FINANCE_AI_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_TRUSTED_ORIGINS=
MCP_ALLOWED_ORIGINS=
# Ubuntu host only, reverse-proxied by your existing Nginx / Cloudflare DNS.
OA_BIND_PORT=3000
